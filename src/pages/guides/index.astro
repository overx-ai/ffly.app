---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NoBreak from '../../components/NoBreak.astro';
import { isoDate, pathFor } from '../../site-pages';
import { parseGuide } from '../../guide-markdown';
import { GUIDES_INDEX, formatGuideDate, getGuides, guidePageSlug } from '../../guides';

const guides = (await getGuides()).map((guide) => ({
  ...guide.data,
  href: pathFor(guidePageSlug(guide)),
  minutes: parseGuide(guide.body).minutes,
}));
---
<BaseLayout
  title="Guides to cheap multi-city trips"
  description="How to plan a cheap trip to several cities in Europe: the cheapest order and dates, and how to book budget flights."
  slug={GUIDES_INDEX}
>
  <Header />
  <main id="main" class="container page">
    <h1>Guides</h1>
    <p class="lead">How to plan a cheap trip to several cities: the order, the dates and how to book the flights.</p>

    <ul class="list">
      {guides.map((g) => (
        <li>
          <h2><a href={g.href}><NoBreak text={g.title} /></a></h2>
          <p>{g.description}</p>
          <p class="meta"><time datetime={isoDate(g.published)}>{formatGuideDate(g.published)}</time> · {g.minutes} min read</p>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</BaseLayout>

<style>
  .lead { color: var(--ink-2); font-size: clamp(17px, 1.6vw, 19px); padding-top: var(--space-md); }
  .list { list-style: none; margin: var(--space-2xl) 0 0; padding: 0; }
  .list li { border-top: 1px solid var(--rule); padding-block: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-sm); }
  .list li:last-child { border-bottom: 1px solid var(--rule); }
  .list h2 { font-size: clamp(1.4rem, 3.4vw, 1.75rem); line-height: 1.15; }
  .list h2 a { color: var(--ink); text-decoration: none; }
  .list h2 a:hover { text-decoration: underline; text-decoration-color: var(--gold); }
  .list p { color: var(--ink-2); }
  .list .meta { font: 400 13px var(--font-mono); }
</style>
