---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchForm from '../components/SearchForm.astro';
import { APP } from '../app';
import { pageLink } from '../site-pages';
---
<BaseLayout
  title="Search cheap multi-city trips"
  description="Pick the cities you want to see. ffly finds the cheapest order and dates to visit them all, free on the web."
  slug="search"
>
  <Header />

  <main id="main" class="container search-page">
    <div class="search-head">
      <p class="lbl">Free web search</p>
      <h1>Search cheap <span class="nw">multi-city</span> trips</h1>
      <p class="lead">
        Tell {APP.name} the cities you want to see. It finds the order and the dates that make the whole trip cost the
        least, with the flights and booking links of the top routes. The {APP.name} app shows every route.
      </p>
    </div>

    <SearchForm />

    <p class="guide-link" set:html={`Read ${pageLink('guides/cheapest-order-to-visit-cities', 'how to find the cheapest order to visit cities')}.`} />
  </main>

  <Footer />
</BaseLayout>

<style>
  .search-page { padding-block: var(--space-2xl) var(--space-3xl); display: flex; flex-direction: column; gap: var(--space-lg); }
  .search-head { display: flex; flex-direction: column; gap: var(--space-md); max-width: var(--max-width-prose); }
  h1 { font-size: clamp(2.4rem, 6vw, 3.4rem); letter-spacing: -0.04em; }
  .guide-link { color: var(--ink-2); font-size: 14px; }
</style>
