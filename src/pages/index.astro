---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import { APP, EXAMPLE_TRIP, PRIORITIES } from '../app';
import { pathFor } from '../site-pages';
import { appSchema, organizationSchema } from '../schema';

const airlines = `${APP.airlines.slice(0, -1).join(', ')}, ${APP.airlines.at(-1)}`;
const listOf = (items: readonly string[]) => `${items.slice(0, -1).join(', ')} or ${items.at(-1)}`;

const steps = [
  {
    title: 'Pick your cities',
    body: `Where you start, up to ${APP.maxEnds} places to finish, and up to ${APP.maxCities} cities to see. Mark each one a must or a maybe: a maybe is skipped when leaving it out makes the trip cheaper.`,
  },
  {
    title: 'Set dates and nights',
    body: 'Choose your travel window and how many nights you want in each city.',
  },
  {
    title: 'Choose what matters',
    body: `${listOf(PRIORITIES)}. Routes are ranked by what you pick.`,
  },
  {
    title: 'Get your routes',
    body: 'ffly runs the search in the background and lets you know when your routes are ready.',
  },
];

// Copy source of truth: ios-ffly docs/specs/002-value-story.md. Its "Never" column binds every line:
// no invented numbers, no saving the search did not measure, no fear copy, no medical claims.
const values = [
  {
    tag: 'Money',
    title: 'The cheapest trip, not the cheapest first flight.',
    body: 'ffly prices whole routes, trying your cities in different orders across your dates, so a bargain first leg cannot lock you into an expensive rest of the trip.',
  },
  {
    tag: 'Hotel nights',
    title: 'Fewer hotel nights you pay for but barely use.',
    body: `Every priority, even ${PRIORITIES.at(-1)}, counts a midnight landing as the hotel night it costs you, so the nights you book are nights you actually sleep there.`,
  },
  {
    tag: 'Time',
    title: 'Hours of tab-hopping, done in minutes.',
    body: `Fares from ${airlines} and more, between all your cities and across every day of your window, compared for you. One search can weigh more than a thousand of them.`,
  },
  {
    tag: 'Sleep',
    title: 'Fewer 3 a.m. alarms.',
    body: 'A 6:05 departure means a 3:30 alarm. ffly favours routes without one, and shows the early starts and lost sleep on the routes that have them.',
  },
  {
    tag: 'Fit',
    title: 'A schedule that fits how you travel.',
    body: `${listOf(PRIORITIES)}: routes are ranked by what you chose. There is no single right way to travel.`,
  },
];

const exampleCities = EXAMPLE_TRIP.stops.filter((st) => 'nights' in st).map((st) => st.city);
const exampleTitle = `${EXAMPLE_TRIP.start} to ${exampleCities.slice(0, -1).join(', ')} and ${exampleCities.at(-1)}`;
const exampleRoute = EXAMPLE_TRIP.stops
  .map((st) => ('nights' in st ? `${st.city} (${st.nights} nights)` : st.city))
  .join(', then ');

const plans = [
  {
    name: 'Free',
    line: `${APP.freeSearches} searches`,
    items: ['The cities in the cheapest order', 'The days in each city', 'The total price'],
  },
  {
    name: APP.proName,
    line: `Every route in full, and no <span class="nw">${APP.freeSearches}-search</span> limit`,
    items: ['Dates and flight times', 'Airlines and booking links', 'Every route, not just the top one'],
  },
];
---
<BaseLayout
  title="ffly: cheap multi-city trips for iPhone"
  description={`Pick the cities you want to see. ffly finds the cheapest order and dates, favours sensible flight times, and checks fares from ${airlines} and more.`}
  slug=""
  structuredData={[appSchema(), organizationSchema()]}
>
  <Header />

  <main id="main">
    <section class="hero">
      <div class="container grid">
        <div class="pitch">
          <p class="lbl">ffly for iPhone</p>
          <h1>Cheap <span class="nw">multi-city</span> trips</h1>
          <p class="lead">
            Pick the cities you want to see. ffly finds the cheapest order and dates to visit them all, then you book
            each flight on the airline's site or a booking site.
          </p>
          <ul class="chips" aria-label="Fare sources">
            {APP.airlines.map((a) => <li>{a}</li>)}
            <li>and more</li>
          </ul>
          <div class="actions">
            <AppStoreBadge />
            <a class="web" href={pathFor('search')}>Try it on the web</a>
            <span class="note">Free in the app: {APP.freeSearches} searches</span>
          </div>
        </div>
        <div class="art">
          <img
            src="/icon-360.webp"
            srcset="/icon-360.webp 360w, /icon-720.webp 720w"
            sizes="(max-width: 860px) 132px, 340px"
            width="360"
            height="360"
            alt="The ffly app icon: a fly with airplane wings following a dotted route between three map pins."
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section class="sec" id="how">
      <div class="container">
        <div class="sec-head">
          <h2>How it works</h2>
          <p>Tell ffly where you want to go. It works out the order, the dates and the flights.</p>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li class="card">
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec" id="why">
      <div class="container">
        <div class="sec-head">
          <h2>What a good route gives back</h2>
          <p>
            Money, nights, hours and sleep. Free shows you the route and its total; {APP.proName} shows every route in
            full, so you can see each of these for yourself.
          </p>
        </div>
        <div class="why">
          <ol class="values">
            {values.map((v) => (
              <li>
                <p class="lbl">{v.tag}</p>
                <h3>{v.title}</h3>
                <p>{v.body}</p>
              </li>
            ))}
          </ol>

          <figure class="card example" aria-label={`Example search: ${exampleRoute}`}>
            <p class="lbl">Example search</p>
            <h3>{exampleTitle}</h3>
            <ol class="chain">
              {EXAMPLE_TRIP.stops.map((st) => (
                <li>
                  <span class="city">{st.city}</span>
                  {'nights' in st && <span class="nights">{st.nights} nights</span>}
                </li>
              ))}
            </ol>
            <p class="total">
              <span>Best of {EXAMPLE_TRIP.routesFound} routes, flights total</span>
              <strong>{EXAMPLE_TRIP.bestTotal}</strong>
            </p>
            <figcaption>
              A real search against live fares on {EXAMPLE_TRIP.date}, starting in {EXAMPLE_TRIP.start} and finishing in
              {' '}{EXAMPLE_TRIP.finish}. It shows what a result looks like, not a price or saving you will get: fares
              change constantly and your trip will differ. This is the Free view; {APP.proName} adds the dates, flight
              times and booking links.
            </figcaption>
          </figure>
        </div>

        <p class="promise">
          <strong>Our promise.</strong> No ads. We don't sell your data.
        </p>
      </div>
    </section>

    <section class="sec" id="plans">
      <div class="container">
        <div class="sec-head">
          <h2>Free and {APP.proName}</h2>
          <p>
            Try ffly free. Upgrade when you want the details. {APP.proName} is a weekly or yearly subscription, or a
            one-time {APP.lifetimeName} purchase, priced in the app in your currency before you buy.
          </p>
        </div>
        <div class="plans">
          {plans.map((p, i) => (
            <article class:list={['card', 'plan', { pro: i === 1 }]}>
              <p class="lbl">{p.name}</p>
              <h3 set:html={p.line} />
              <ul>
                {p.items.map((it) => <li>{it}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <p class="fine">
          Subscriptions renew automatically unless cancelled at least 24 hours before the period ends.
          {APP.lifetimeName} is a one-time purchase and does not renew. See the
          <a href={pathFor('terms')}>Terms of Use</a>.
        </p>
      </div>
    </section>

    <section class="sec close">
      <div class="container">
        <h2>Where to next?</h2>
        <p>Pick the cities. ffly does the ordering, the dates and the fare checks.</p>
        <AppStoreBadge />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero { padding-block: var(--space-3xl) var(--space-2xl); overflow: hidden; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--space-3xl);
    align-items: center;
  }
  .pitch { display: flex; flex-direction: column; gap: var(--space-lg); }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    letter-spacing: -0.035em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.06em;
  }
  .lead { color: var(--ink-2); font-size: 1.2rem; max-width: 30em; }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-sm); list-style: none; padding: 0; margin: 0; }
  .chips li {
    font-size: 14px;
    color: var(--ink-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    padding: 4px 12px;
  }
  .actions { display: flex; align-items: center; gap: var(--space-md) var(--space-lg); flex-wrap: wrap; padding-top: var(--space-xs); }
  .note { color: var(--ink-3); font-size: 14px; }
  .web { font-family: var(--font-display); font-weight: 700; min-height: 44px; display: inline-flex; align-items: center; }

  .art { display: flex; justify-content: center; min-width: 0; }
  .art img {
    width: 340px;
    border-radius: 22.5%;
    box-shadow: 0 30px 80px var(--glow), var(--shadow);
  }

  .steps, .plans {
    display: grid;
    gap: var(--space-lg);
    margin: var(--space-2xl) 0 0;
    padding: 0;
    list-style: none;
  }
  .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .step-num {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--grad);
    color: var(--on-brand);
    font-family: var(--font-display);
    font-weight: 800;
    margin-bottom: var(--space-md);
  }
  .steps h3 { font-size: 1.2rem; padding-bottom: var(--space-sm); }
  .steps p { color: var(--ink-2); font-size: 15px; }

  .why {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: start;
    margin-top: var(--space-2xl);
  }
  .values { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .values li { padding-block: var(--space-lg); border-top: 1px solid var(--rule-soft); }
  .values li:first-child { border-top: 0; padding-top: 0; }
  .values h3 { font-size: 1.3rem; padding-block: var(--space-xs) var(--space-sm); }
  .values li > p:last-child { color: var(--ink-2); font-size: 15.5px; }

  .example { margin: 0; position: sticky; top: 88px; }
  .example h3 { font-size: 1.2rem; padding-block: var(--space-xs) var(--space-md); }
  .total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    border-top: 1px solid var(--rule-soft);
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    color: var(--ink-2);
    font-size: 15px;
  }
  .total strong { font-family: var(--font-display); font-size: 1.6rem; color: var(--ink); font-variant-numeric: tabular-nums; }
  .example figcaption { color: var(--ink-3); font-size: 13px; line-height: 1.5; padding-top: var(--space-md); }

  .promise {
    margin-top: var(--space-2xl);
    padding: var(--space-md) var(--space-lg);
    border-left: 3px solid var(--brand);
    background: var(--raise);
    border-radius: var(--radius-md);
    color: var(--ink-2);
  }
  .promise strong { color: var(--ink); }

  .plan h3 { font-size: 1.4rem; padding-block: var(--space-sm) var(--space-md); }
  .plan ul { margin: 0; padding-left: 1.2em; color: var(--ink-2); display: flex; flex-direction: column; gap: 6px; }
  .plan.pro { border: 1.5px solid transparent; background: linear-gradient(var(--bg), var(--bg)) padding-box, var(--grad) border-box; }
  .fine { color: var(--ink-3); font-size: 14px; padding-top: var(--space-lg); }

  .close { text-align: center; }
  .close h2 { font-size: clamp(1.9rem, 4vw, 2.6rem); }
  .close p { color: var(--ink-2); max-width: 34em; margin: var(--space-md) auto var(--space-lg); }

  @media (max-width: 960px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .why { grid-template-columns: minmax(0, 1fr); }
    .example { position: static; }
  }
  @media (max-width: 860px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-2xl); }
    .art { order: -1; justify-content: flex-start; }
    .art img { width: 132px; box-shadow: 0 16px 40px var(--glow); }
    .hero { padding-top: var(--space-xl); }
  }
  @media (max-width: 640px) {
    .steps, .plans { grid-template-columns: minmax(0, 1fr); }
    .sec { padding-block: var(--space-2xl); }
  }
</style>
