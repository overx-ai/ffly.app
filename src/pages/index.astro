---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StoreCtas from '../components/StoreCtas.astro';
import RouteMap from '../components/RouteMap.astro';
import BoardingPass from '../components/BoardingPass.astro';
import SearchForm from '../components/SearchForm.astro';
import { APP, EXAMPLE_TRIP, PRIORITIES, WEB_SEARCH } from '../app';
import { formatDate, pageLink, pathFor } from '../site-pages';
import { appSchema, faqSchema, organizationSchema } from '../schema';
import type { FaqItem } from '../data/types';

const airlines = APP.airlines.join(', ');
const priorities = PRIORITIES.map((p, i) => (i ? p.toLowerCase() : p));
const listOf = (items: readonly string[]) => `${items.slice(0, -1).join(', ')} or ${items.at(-1)}`;
const searchedOn = formatDate(new Date(EXAMPLE_TRIP.searchedOn));
const caveat = `Example search on live fares, ${searchedOn}. Not a price or saving you will get: fares change and your trip will differ.`;
const webSearches = WEB_SEARCH.freeSearchesPerDay === 1 ? 'once a day' : `${WEB_SEARCH.freeSearchesPerDay} times a day`;

const ICONS = {
  money: '<circle cx="12" cy="12" r="9"/><path d="M15 8.5a3.5 3.5 0 1 0 0 7M8 11h5M8 13.5h5"/>',
  time: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  sleep: '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>',
  fit: '<path d="M4 7h10M4 12h16M4 17h7"/><circle cx="17" cy="7" r="2"/><circle cx="14" cy="17" r="2"/>',
};

// Copy source of truth: ios-ffly docs/specs/002-value-story.md. Its "Never" column binds every line:
// no invented numbers, no saving the search did not measure, no fear copy, no medical claims.
const values = [
  {
    icon: ICONS.money,
    title: 'The cheapest whole trip, not the cheapest first flight.',
    body: `A bargain first leg can make the rest of the trip expensive. ${APP.name} looks at the trip as a whole.`,
  },
  {
    icon: ICONS.time,
    title: 'Hours of tab-hopping, done in minutes.',
    body: 'No spreadsheet of dates and cities. You get the routes worth booking.',
  },
  {
    icon: ICONS.sleep,
    title: 'Fewer 3 a.m. alarms.',
    body: `${APP.name} favours sensible flight times over pre-dawn wake-ups and midnight landings.`,
  },
  {
    icon: ICONS.fit,
    title: 'Ranked by how you travel.',
    body: `${listOf(priorities)}. You choose what matters most.`,
  },
];

const plans = [
  {
    name: 'Free',
    line: `Your first ${APP.freeSearches} searches, in full`,
    body: 'Every route with its dates, flight times, airlines and booking links.',
  },
  {
    name: APP.proName,
    line: `Every route in full, and no <span class="nw">${APP.freeSearches}-search</span> limit`,
    body: `For every trip after your free searches. Weekly, yearly or a one-time ${APP.lifetimeName} purchase, priced in the app.`,
    pro: true,
  },
];

const faq: FaqItem[] = [
  {
    question: `What is ${APP.name}?`,
    answer: `${APP.name} is an iPhone app for cheap multi-city trips. Pick the cities you want to visit, your dates and how long to stay in each. ${APP.name} shows the order and dates where the whole trip costs least, and you book each flight with the airline or a booking site.`,
  },
  {
    question: 'How is it different from searching flights one by one?',
    answer: `Booking the cheapest next flight each time can leave you with an expensive trip overall. ${APP.name} compares whole routes, so the total is what gets cheaper. See ${pageLink('guides/cheapest-order-to-visit-cities', 'how to find the cheapest order to visit cities')}.`,
  },
  {
    question: `Which airlines does ${APP.name} cover?`,
    answer: `${airlines} and more. You book on the airline's site or a booking site.`,
  },
  {
    question: `Is ${APP.name} free?`,
    answer: `Your first ${APP.freeSearches} searches in the app are free and in full, and you can try a search on the web ${webSearches}. ${APP.proName} is for every trip after.`,
  },
  {
    question: `Does ${APP.name} sell tickets?`,
    answer: `No. ${APP.name} is a search tool, not a travel agent. Fares are indicative, so confirm the final price where you book. Weighing up one booking against several? Read ${pageLink('guides/multi-city-vs-one-way-tickets', 'multi-city vs one-way tickets')}.`,
  },
  {
    question: 'Is there an Android app?',
    answer: `${APP.name} is an iPhone app. On any other device you can try a search on the web.`,
  },
];
---
<BaseLayout
  title="ffly: Cheap Multi-City Flights and Trip Planner"
  description={`Pick your cities. ${APP.name} finds the cheapest order and dates for the whole trip, with sensible flight times, on ${airlines} and more.`}
  slug=""
  structuredData={[appSchema(), organizationSchema(), faqSchema(faq)]}
>
  <Header />

  <main id="main">
    <section class="hero container">
      <div class="hero-grid">
        <div class="pitch">
          <h1>The cheapest way to see them all.</h1>
          <p class="sub">
            Tell {APP.name} the cities you want to see. It finds the order and the dates that make the whole trip cost the
            least, and favours flight times you can live with.
          </p>
          <StoreCtas />
          <p class="airlines">Fares from {airlines} and more</p>
        </div>
        <figure class="hero-map">
          <RouteMap />
          <div class="legend">
            <span>Example search · best of {EXAMPLE_TRIP.routesFound} routes, flights total</span>
            <b>{EXAMPLE_TRIP.bestTotal}</b>
          </div>
          <figcaption>{caveat}</figcaption>
        </figure>
      </div>
    </section>

    <section class="sect container" id="search" tabindex="-1" aria-labelledby="search-title">
      <h2 id="search-title">Search routes free</h2>
      <SearchForm />
    </section>

    <section class="sect container" id="why">
      <h2>What a good route gives back</h2>
      <div class="vals">
        {values.map((v) => (
          <article>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={v.icon} />
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sect container" id="plans">
      <h2>{APP.freeSearches} full searches free in the app; Pro for every trip after.</h2>
      <div class="pass-wrap">
        <BoardingPass caption={caveat} />
        <div class="plans">
          {plans.map((p) => (
            <div class:list={['plan', { pro: p.pro }]}>
              <p class="plan-name">{p.name}</p>
              <h3 set:html={p.line} />
              <p>{p.body}</p>
            </div>
          ))}
          <p class="promise">No ads in the app. We don't sell your data.</p>
          <p class="fine">
            Subscriptions renew automatically unless cancelled at least 24 hours before the period ends. See the
            <a href={pathFor('terms')}>Terms of Use</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="sect container" id="faq">
      <h2>Questions</h2>
      <div class="faq home-faq">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <div><p set:html={item.answer} /></div>
          </details>
        ))}
      </div>
    </section>

    <section class="close">
      <div class="container close-inner">
        <h2>Pick the cities. {APP.name} finds the trip.</h2>
        <StoreCtas />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero { padding-block: var(--space-xl) var(--space-3xl); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
  }
  h1 {
    font-size: clamp(42px, 6.4vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .sub { font-size: clamp(17px, 1.6vw, 20px); color: var(--ink-2); max-width: 36ch; margin: 20px 0 28px; }
  .airlines { margin-top: 26px; font-size: 14px; color: var(--ink-2); }

  .hero-map { margin: 0; min-width: 0; }
  .legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 6px 18px;
    border-top: 1px solid var(--rule);
    padding-top: 12px;
    margin-top: 4px;
  }
  .legend span { font-size: 14px; color: var(--ink-2); }
  .legend b { font: 800 30px var(--font-display); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .hero-map figcaption { font-size: 13px; color: var(--ink-2); margin-top: 4px; max-width: 70ch; }

  .sect { padding-block: clamp(48px, 7vw, 88px); border-top: 1px solid var(--rule); scroll-margin-top: var(--header-offset); }
  #search { scroll-margin-top: var(--header-height); }
  #search:focus { outline: none; }
  .sect h2 {
    font-size: clamp(30px, 4.2vw, 52px);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 30px;
    max-width: 20ch;
  }

  .vals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px) clamp(28px, 5vw, 72px);
  }
  .vals article { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 16px; align-items: start; }
  .vals svg {
    grid-row: span 2;
    width: 34px;
    height: 34px;
    stroke: var(--accent);
    stroke-width: 1.8;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .vals h3 { font-size: 22px; font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; }
  .vals p { color: var(--ink-2); }

  .pass-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  .plans { display: flex; flex-direction: column; gap: 22px; }
  .plan { display: flex; flex-direction: column; gap: 6px; padding-left: 16px; border-left: 3px solid var(--rule); }
  .plan.pro { border-left-color: var(--gold); }
  .plan-name {
    font: 700 13px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .pro .plan-name { color: var(--accent); }
  .plan h3 { font-size: 24px; line-height: 1.1; }
  .plan p:last-child { color: var(--ink-2); }
  .promise { font: 700 18px var(--font-display); margin-top: 6px; }
  .fine { font-size: 13px; color: var(--ink-2); }

  .home-faq {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
    max-width: none;
  }
  .home-faq details:last-child { border-bottom: 0; }

  .close {
    background: var(--night);
    color: var(--on-night);
    --store-bg: var(--on-night);
    --store-ink: var(--night);
  }
  .close-inner {
    padding-block: clamp(56px, 9vw, 112px);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .close h2 {
    font-size: clamp(34px, 5.2vw, 66px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    max-width: 15ch;
  }

  @media (max-width: 900px) {
    .pass-wrap { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 760px) {
    .hero-grid, .vals, .home-faq { grid-template-columns: minmax(0, 1fr); }
    .hero-map { order: -1; }
    .hero { padding-top: var(--space-md); }
  }
</style>
