---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NoBreak from '../components/NoBreak.astro';
import StoreCtas from '../components/StoreCtas.astro';
import { APP, DEVELOPER } from '../app';
import { isoDate, pathFor } from '../site-pages';
import { articleSchema, faqSchema, howToSchema, type Crumb } from '../schema';
import { parseGuide } from '../guide-markdown';
import { GUIDES_INDEX, formatGuideDate, guidePageSlug, type Guide } from '../guides';

interface Props { guide: Guide; }

const { guide } = Astro.props;
const { title, description, published, updated } = guide.data;
const slug = guidePageSlug(guide);
const { h1, faq, howTo, minutes } = parseGuide(guide.body);
const parent: Crumb = { name: 'Guides', slug: GUIDES_INDEX };
const structuredData = [
  articleSchema({ headline: h1, description, slug, published, updated }),
  ...(faq.length ? [faqSchema(faq)] : []),
  ...(howTo ? [howToSchema(howTo)] : []),
];
---
<BaseLayout
  title={title}
  description={description}
  slug={slug}
  ogType="article"
  parent={parent}
  structuredData={structuredData}
>
  <Header />
  <main id="main" class="container page guide">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={pathFor('')}>Home</a></li>
        <li><a href={pathFor(parent.slug)}>{parent.name}</a></li>
      </ol>
    </nav>

    <article>
      <h1><NoBreak text={h1} /></h1>
      <p class="byline">
        <span>By {DEVELOPER} ·</span>
        <span><time datetime={isoDate(published)}>{formatGuideDate(published)}</time> ·</span>
        <span>{minutes} min read</span>
      </p>
      <div class="prose"><slot /></div>
    </article>

    <aside class="card cta" aria-label={`${APP.name} for iPhone`}>
      <p class="lbl">{APP.name} for iPhone</p>
      <p>Pick the cities. {APP.name} finds the order and dates where the whole trip costs least.</p>
      <StoreCtas />
    </aside>
  </main>
  <Footer />
</BaseLayout>

<style>
  .guide { padding-top: var(--space-xl); }
  .guide h1 { font-size: clamp(2rem, 5.5vw, 3rem); line-height: 1.08; padding-top: var(--space-md); }

  .crumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    font: 500 13px var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .crumbs li + li::before { content: "/"; color: var(--ink-2); padding-inline: 10px; }
  .crumbs li { display: inline-flex; align-items: center; min-height: 44px; }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs a:hover { color: var(--ink); }

  .byline {
    font: 400 14px var(--font-mono);
    color: var(--ink-2);
    padding-top: var(--space-md);
  }
  .byline span { white-space: nowrap; }

  .prose {
    padding-top: var(--space-xl);
    font-size: 17px;
    line-height: 1.65;
    overflow-wrap: break-word;
  }
  .prose > :global(* + *) { margin-top: var(--space-md); }
  .prose :global(h2) {
    font-size: clamp(1.55rem, 3.6vw, 1.95rem);
    line-height: 1.12;
    margin-top: var(--space-2xl);
    scroll-margin-top: var(--header-offset);
  }
  .prose :global(h3) {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-top: var(--space-xl);
    scroll-margin-top: var(--header-offset);
  }
  .prose :global(:is(h2, h3) + *) { margin-top: 12px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; margin-bottom: 0; }
  .prose :global(li + li) { margin-top: 6px; }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(a) { overflow-wrap: anywhere; }

  .prose :global(.table-scroll) {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    margin-top: var(--space-lg);
  }
  .prose :global(table) {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.45;
  }
  .prose :global(th), .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 10px 14px;
    border-bottom: 1px solid var(--rule);
  }
  .prose :global(thead th) { background: var(--fill); font-weight: 700; }
  .prose :global(tbody tr:last-child td) { border-bottom: 0; }
  .prose :global(td:first-child) { font-weight: 700; }

  /* The FAQ: questions are the h3s after "## FAQ", up to the next h2. */
  .prose :global(#faq ~ h3:not(#faq ~ h2 ~ h3)) {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-md);
    margin-top: var(--space-lg);
    font-size: 1.1rem;
  }
  .prose :global(#faq ~ h3:not(#faq ~ h2 ~ h3) + p) { color: var(--ink-2); margin-top: var(--space-sm); }

  .prose :global(#key-takeaways + ul) {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius-md);
    padding: var(--space-lg) var(--space-lg) var(--space-lg) calc(var(--space-lg) + 1.1em);
  }

  .cta {
    margin-top: var(--space-3xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }
  .cta p:not(.lbl) { font: 700 1.2rem/1.3 var(--font-display); letter-spacing: -0.01em; }
</style>
