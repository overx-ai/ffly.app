---
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner.astro';
import { ADSENSE_CLIENT, ADSENSE_SCRIPT, APP, APP_STORE_ID, CONSENT_SCRIPT, FFLY_API_BASE } from '../app';
import { DEFAULT_LANG, LANGS, localeOf, useLang, type Lang } from '../i18n';
import { DEFAULT_OG_IMAGE, alternates, siteOrigin, urlFor, type Slug } from '../site-pages';
import { breadcrumb, websiteSchema, type Crumb } from '../schema';

interface Props {
  title: string;
  description: string;
  slug?: Slug;
  ogImage?: string;
  ogType?: 'website' | 'article';
  parent?: Crumb;
  structuredData?: object[];
  lang?: Lang;
  preconnectApi?: boolean;
}

const {
  title,
  description,
  slug,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  parent,
  structuredData = [],
  lang = DEFAULT_LANG,
  preconnectApi = false,
} = Astro.props;
const { t } = useLang(lang);
const locale = localeOf(lang);

// Match --bg in src/styles/global.css (light :root, dark media block).
const THEME_COLOR = { light: '#F4F6FB', dark: '#040A1C' };
const PRELOAD_FONTS = ['/fonts/bricolage-grotesque-700-800-latin.woff2', '/fonts/figtree-latin.woff2'];

// A page outside SITE_PAGES (the 404) has no slug, so it gets no canonical URL and stays out of search.
const noindex = slug === undefined;
const canonical = noindex ? undefined : urlFor(slug, lang);
const links = noindex ? [] : alternates(slug);
// The home title already names the brand; suffixing it would render "ffly ... | ffly".
const fullTitle = slug === '' ? title : `${title} | ${APP.name}`;
// set:html is unescaped, so "<" becomes \u003c: no string in the data can close the script element.
const jsonLd = (schema: object) => JSON.stringify(schema).replace(/</g, '\\u003c');
let schemas = structuredData;
if (slug === '') schemas = [websiteSchema(lang), ...structuredData];
else if (slug !== undefined) schemas = [...structuredData, breadcrumb(title, slug, parent, lang)];
---
<!doctype html>
<html lang={locale.tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {links.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={APP.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {links.length > 0 && <meta property="og:locale" content={locale.og} />}
    {links.length > 0 &&
      LANGS.filter((l) => l.code !== lang).map((l) => <meta property="og:locale:alternate" content={l.og} />)}
    <meta property="og:image" content={`${siteOrigin}${ogImage}`} />
    {/* Hardcoded to match public/og-image.jpg. Change both together. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta name="twitter:card" content="summary_large_image" />

    {APP_STORE_ID && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />}

    {/* Raster icons only. An image/svg+xml icon would silently outrank every PNG. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
    {preconnectApi && <link rel="preconnect" href={new URL(FFLY_API_BASE).origin} crossorigin />}
    {PRELOAD_FONTS.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    {/* Google's certified consent message first, then AdSense, which waits for its consent signal. */}
    {ADSENSE_CLIENT && <script async src={CONSENT_SCRIPT(ADSENSE_CLIENT)} />}
    {ADSENSE_CLIENT && <script async src={ADSENSE_SCRIPT(ADSENSE_CLIENT)} crossorigin="anonymous" />}

    {schemas.map((s) => (
      <script type="application/ld+json" set:html={jsonLd(s)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.common.skipLink}</a>
    <slot />
    <ConsentBanner lang={lang} />
  </body>
</html>
