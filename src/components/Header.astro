---
import { APP } from '../app';
import { pathFor } from '../site-pages';
const home = pathFor('');
---
<header>
  <div class="container bar">
    <a class="brand" href={home}>
      <img src="/icon-64.webp" width="32" height="32" alt="" />
      <span>{APP.name}</span>
    </a>
    <nav aria-label="Main">
      <!-- Absolute, not bare fragments: the ids live on the home page only. -->
      <a href={`${home}#how`}>How it works</a>
      <a href={`${home}#why`}>Why ffly</a>
      <a href={`${home}#plans`}>Free and Pro</a>
      <a href={pathFor('search')}>Web search</a>
      <a href={pathFor('support')}>Support</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 5;
    backdrop-filter: saturate(160%) blur(12px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--rule-soft);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: 12px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.01em;
    min-height: 44px;
  }
  .brand img { border-radius: 8px; }
  .brand:hover { text-decoration: none; }
  nav { display: flex; align-items: center; gap: var(--space-lg); }
  nav a {
    color: var(--ink-2);
    font-size: 15px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  nav a:hover { color: var(--ink); text-decoration: none; }
  @media (max-width: 560px) {
    nav { gap: var(--space-md); }
    nav a[href*="#"] { display: none; }
  }
</style>
