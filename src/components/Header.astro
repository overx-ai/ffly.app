---
import { APP } from '../app';
import { DEFAULT_LANG, useLang, type Lang } from '../i18n';
import { hreflangOf, pathFor } from '../site-pages';

interface Props { lang?: Lang; }

const { lang = DEFAULT_LANG } = Astro.props;
const { nav } = useLang(lang).t.common;
const home = pathFor('', lang);
---
<header>
  <div class="container bar">
    <a class="brand" href={home}>
      <img src="/icon-64.webp" width="32" height="32" alt="" />
      <span>{APP.name}</span>
    </a>
    <nav aria-label={nav.label}>
      {/* Absolute, not bare fragments: the ids live on the home page only. */}
      <a class="wide" href={`${home}#why`}>{nav.why}</a>
      <a class="wide" href={`${home}#plans`}>{nav.plans}</a>
      <a href={`${home}#search`}>{nav.search}</a>
      <a href={pathFor('support', lang)} hreflang={hreflangOf('support', lang)}>{nav.support}</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 5;
    backdrop-filter: saturate(160%) blur(12px);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: 10px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.03em;
    min-height: 44px;
    text-decoration: none;
  }
  .brand img { border-radius: 8px; }
  nav { display: flex; align-items: center; gap: var(--space-lg); }
  nav a {
    color: var(--ink-2);
    font-size: 15px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  nav a:hover { color: var(--ink); }
  @media (max-width: 760px) {
    nav { gap: var(--space-md); }
    nav .wide { display: none; }
  }
</style>
