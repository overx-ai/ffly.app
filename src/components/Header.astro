---
import LanguageLinks from './LanguageLinks.astro';
import { APP } from '../app';
import { DEFAULT_LANG, localeOf, shortCode, useLang, type Lang } from '../i18n';
import { hreflangOf, pathFor, type Slug } from '../site-pages';

interface Props {
  lang?: Lang;
  slug?: Slug;
}

const { lang = DEFAULT_LANG, slug } = Astro.props;
const { nav, footer } = useLang(lang).t.common;
const home = pathFor('', lang);
const code = shortCode(localeOf(lang));
---
<header>
  <div class="container bar">
    <a class="brand" href={home}>
      <img src="/mark-128.webp" srcset="/mark-128.webp 1x, /mark-256.webp 2x" width="44" height="44" alt="" />
      <span>{APP.name}</span>
    </a>
    <nav aria-label={nav.label}>
      {/* Absolute, not bare fragments: the ids live on the home page only. */}
      <a class="wide" href={`${home}#why`}>{nav.why}</a>
      <a class="wide" href={`${home}#plans`}>{nav.plans}</a>
      <a href={`${home}#search`}>{nav.search}</a>
      <a href={pathFor('support', lang)} hreflang={hreflangOf('support', lang)}>{nav.support}</a>
      <details class="lang-menu">
        <summary aria-label={`${footer.languages} (${code})`}>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
          </svg>
          <span aria-hidden="true">{code}</span>
        </summary>
        <nav class="lang-panel" aria-label={footer.languages}>
          <LanguageLinks lang={lang} slug={slug} />
        </nav>
      </details>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 5;
    backdrop-filter: saturate(160%) blur(12px);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: 10px;
  }
  .brand {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.03em;
    min-height: 44px;
    text-decoration: none;
  }
  .brand img { border-radius: 11px; }
  nav { display: flex; align-items: center; gap: var(--space-lg); }
  nav a {
    color: var(--ink-2);
    font-size: 15px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  nav a:hover { color: var(--ink); }
  .lang-menu { position: relative; }
  .lang-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 44px;
    min-height: 44px;
    padding-inline: 10px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font: 600 13px var(--font-mono);
    list-style: none;
    cursor: pointer;
  }
  .lang-menu summary::-webkit-details-marker { display: none; }
  .lang-menu summary:hover,
  .lang-menu[open] summary { color: var(--ink); border-color: var(--ink-2); }
  .lang-panel {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    width: max-content;
    max-width: calc(100vw - 2 * var(--gutter));
    padding: 6px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow);
  }
  .lang-panel :global(a) {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 12px;
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: 15px;
    text-decoration: none;
  }
  .lang-panel :global(a:hover) { background: var(--fill); }
  .lang-panel :global([aria-current]) { background: var(--fill); font-weight: 700; }
  @media (max-width: 760px) {
    nav { gap: var(--space-md); }
    nav .wide { display: none; }
  }
  @media (max-width: 400px) {
    .bar, nav { gap: 12px; }
    .lang-menu summary { padding-inline: 0; justify-content: center; }
    .lang-menu summary span { display: none; }
  }
  @media (max-width: 359px) {
    .brand span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
