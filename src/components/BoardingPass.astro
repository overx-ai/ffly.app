---
import { APP, EXAMPLE_TRIP } from '../app';
import { DEFAULT_LANG, useLang, type Lang } from '../i18n';
import { exampleCity } from '../example-city';

interface Props {
  caption: string;
  lang?: Lang;
}

const { caption, lang = DEFAULT_LANG } = Astro.props;
const { t, tag, fmt } = useLang(lang);
const pass = t.pass;

// Illustrative flight details for the promo pass (the example search kept no legs): days follow the nights,
// times stay sensible. Reused in turn on a longer trip.
const FLIGHTS = [
  { day: '2026-10-14', time: '10:05', flight: 'FR 1062' },
  { day: '2026-10-16', time: '09:40', flight: 'KL 1705' },
  { day: '2026-10-18', time: '11:25', flight: 'HV 5401' },
  { day: '2026-10-22', time: '13:50', flight: 'W6 1452' },
];
const BARCODE = { width: 196, height: 46 };
const LCG = { multiplier: 1103515245, increment: 12345 };

const { stops } = EXAMPLE_TRIP;
const first = stops[0];
const last = stops[stops.length - 1];
const visits = stops.filter((s) => 'nights' in s);
const nights = visits.reduce((sum, s) => sum + ('nights' in s ? s.nights : 0), 0);
const passDate = (iso: string, year?: 'numeric') =>
  fmt.date(new Date(iso), { day: '2-digit', month: 'short', year }).toLocaleUpperCase(tag);
const searched = passDate(EXAMPLE_TRIP.searchedOn, 'numeric');
const total = fmt.money(EXAMPLE_TRIP.bestTotal, EXAMPLE_TRIP.currency);
const legs = stops.slice(0, -1).map((from, i) => ({ from, to: stops[i + 1], flight: FLIGHTS[i % FLIGHTS.length] }));
const route = stops.map((s) => s.code).join('-');

// Decorative barcode: bar widths from a tiny LCG seeded by the route, so it is stable across builds.
let seed = [...route].reduce((acc, ch) => (acc * 31 + ch.charCodeAt(0)) >>> 0, 7);
const bars: { x: number; w: number }[] = [];
for (let x = 0; x < BARCODE.width; ) {
  seed = (Math.imul(seed, LCG.multiplier) + LCG.increment) >>> 0;
  const w = 1 + ((seed >>> 16) % 3);
  if ((seed >>> 8) & 1) bars.push({ x, w });
  x += w + 1;
}
---
<figure class="pass-fig">
  <div
    class="pass"
    role="group"
    aria-label={pass.label}
  >
    <div class="band">
      <b><img src="/mark-128.webp" srcset="/mark-128.webp 1x, /mark-256.webp 2x" width="28" height="28" alt="" />{APP.name}</b>
      <span>{pass.band} · <span class="gold">{fmt.text(pass.routeOf, { n: EXAMPLE_TRIP.routesFound })}</span></span>
    </div>
    <div class="main">
      <div class="ends">
        <div><span class="k">{pass.from}</span><div class="iata">{first.code}</div><small>{exampleCity(first, tag)}</small></div>
        <div class="via">{pass.via} {visits.map((s) => s.code).join(' · ')}</div>
        <div class="r"><span class="k">{pass.to}</span><div class="iata">{last.code}</div><small>{exampleCity(last, tag)}</small></div>
      </div>
      <div class="meta">
        <div><span class="k">{pass.passenger}</span><b>{pass.you}</b></div>
        <div><span class="k">{pass.cities}</span><b>{visits.length}</b></div>
        <div><span class="k">{pass.nights}</span><b>{nights}</b></div>
        <div><span class="k">{pass.searched}</span><b>{searched}</b></div>
      </div>
      <div class="tbl">
        <table>
          <thead>
            <tr><th>{pass.leg}</th><th>{pass.nights}</th><th>{pass.date}</th><th class="col-departs">{pass.departs}</th><th class="col-flight">{pass.flight}</th></tr>
          </thead>
          <tbody>
            {legs.map((leg) => (
              <tr>
                <td class="leg">{leg.from.code} → {leg.to.code} <span>{exampleCity(leg.to, tag)}</span></td>
                <td>{'nights' in leg.to ? leg.to.nights : pass.end}</td>
                <td class="mono">{passDate(leg.flight.day)}</td>
                <td class="col-departs mono">{leg.flight.time}</td>
                <td class="col-flight mono">{leg.flight.flight}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div class="stub">
      <div><span class="k">{pass.total}</span><div class="total">{total}</div></div>
      <span class="stamp">{pass.stampLead}<br />{fmt.plural(pass.stampRoutes, EXAMPLE_TRIP.routesFound)}</span>
      <svg class="barcode" viewBox={`0 0 ${BARCODE.width} ${BARCODE.height}`} preserveAspectRatio="none" aria-hidden="true">
        {bars.map((b) => <rect x={b.x} y="0" width={b.w} height={BARCODE.height} />)}
      </svg>
    </div>
  </div>
  <figcaption>{caption} {pass.illustrative}</figcaption>
</figure>

<style>
  /* A physical object, so the pass stays paper-white in both colour schemes. */
  .pass-fig {
    --paper: var(--white);
    --paper-ink: var(--navy-ink);
    --paper-mute: var(--navy-mute);
    --paper-rule: var(--navy-line);
    margin: 0;
    min-width: 0;
    container-type: inline-size;
  }
  .pass {
    background: var(--paper);
    color: var(--paper-ink);
    border-radius: var(--radius-lg);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 168px;
    box-shadow: var(--shadow);
    overflow: hidden;
    min-width: 0;
  }
  .band {
    grid-column: 1 / -1;
    background: var(--navy);
    color: var(--on-night);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    font: 600 11px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .band b {
    font: 800 18px var(--font-display);
    letter-spacing: -0.02em;
    text-transform: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .band img { border-radius: var(--radius-sm); }
  .gold { color: var(--gold); }
  .main { padding: 18px 22px 20px; min-width: 0; }
  .k {
    display: block;
    font: 500 10px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper-mute);
  }
  .ends { display: grid; grid-template-columns: auto 1fr auto; align-items: end; gap: 12px; margin-bottom: 14px; }
  .iata { font: 800 clamp(34px, 9cqi, 52px) / 1 var(--font-display); letter-spacing: -0.03em; }
  .ends small { display: block; font: 500 12px var(--font-body); color: var(--paper-mute); }
  .via {
    align-self: center;
    text-align: center;
    font: 500 11px var(--font-mono);
    color: var(--paper-mute);
    border-top: 1.5px dashed var(--paper-rule);
    padding-top: 6px;
    letter-spacing: 0.06em;
  }
  .r { text-align: right; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 26px;
    padding-block: 10px;
    border-block: 1px solid var(--paper-rule);
    margin-bottom: 6px;
  }
  .meta b { font: 600 14px var(--font-mono); }
  table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  th {
    font: 500 10px var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper-mute);
    text-align: left;
    padding: 8px 6px 6px 0;
  }
  td { padding: 7px 6px 7px 0; border-top: 1px solid var(--paper-rule); white-space: nowrap; }
  td.leg { font: 600 13.5px var(--font-mono); }
  td.leg span { color: var(--paper-mute); font-weight: 400; font-family: var(--font-body); }
  .mono { font-family: var(--font-mono); }
  .stub {
    border-left: 2px dashed var(--paper-rule);
    padding: 18px 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    min-width: 0;
  }
  .stub::before,
  .stub::after {
    content: "";
    position: absolute;
    left: -12px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--bg);
  }
  .stub::before { top: -11px; }
  .stub::after { bottom: -11px; }
  .total { font: 800 32px / 1 var(--font-display); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .stamp {
    align-self: flex-start;
    font: 700 10px / 1.3 var(--font-mono);
    color: var(--red);
    border: 1.5px solid var(--red);
    border-radius: var(--radius-sm);
    padding: 5px 7px;
    transform: rotate(-5deg);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .barcode { width: 100%; height: 46px; display: block; margin-top: auto; }
  .barcode rect { fill: var(--paper-ink); }
  figcaption { font-size: 13px; color: var(--ink-2); margin-top: 12px; }

  @container (max-width: 520px) {
    .pass { grid-template-columns: minmax(0, 1fr); }
    .stub {
      border-left: 0;
      border-top: 2px dashed var(--paper-rule);
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    .stub::before, .stub::after { display: none; }
    .barcode { grid-column: 1 / -1; }
    .tbl { overflow-x: auto; }
    .col-flight { display: none; }
    .main { padding-inline: 16px; }
  }
  @container (max-width: 400px) {
    .col-departs { display: none; }
  }
</style>
