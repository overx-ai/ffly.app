---
import { AD_NETWORK_SCRIPT, CONSENT_NEEDED, GA_MEASUREMENT_ID } from '../app';
import { DEFAULT_LANG, useLang, type Lang } from '../i18n';
import { hreflangOf, pathFor } from '../site-pages';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LANG } = Astro.props;
const { consent } = useLang(lang).t;
// One sentence per purpose that waits for consent, so the banner never asks about something the site does not load.
const text = [GA_MEASUREMENT_ID && consent.analytics, AD_NETWORK_SCRIPT && consent.partner, consent.ask].filter(Boolean).join(' ');
// The slim phone line names both purposes, so it shows only while both wait for consent.
const short = GA_MEASUREMENT_ID && AD_NETWORK_SCRIPT ? consent.short : text;
---
{CONSENT_NEEDED && (
  <div id="consent" class="consent" role="region" aria-label={consent.label} hidden>
    <p>
      <span class="wide">{text}{' '}</span><span class="slim">{short}{' '}</span>
      <a href={`${pathFor('privacy', lang)}#website`} hreflang={hreflangOf('privacy', lang)}>{consent.privacy}</a>
    </p>
    <div class="choices">
      <button type="button" data-consent="granted">{consent.accept}</button>
      <button type="button" data-consent="denied">{consent.reject}</button>
    </div>
  </div>
)}

<script>
  import '../scripts/consent';
</script>

<style>
  .consent {
    position: fixed;
    z-index: 20;
    inset-inline: var(--space-sm);
    bottom: calc(var(--space-sm) + var(--safe-bottom));
    max-width: 560px;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    padding: 12px var(--space-md);
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    font-size: 14px;
    line-height: 1.45;
  }
  .consent[hidden] { display: none; }
  .consent p { flex: 1 1 260px; }
  .consent a { white-space: nowrap; }
  .choices { display: flex; gap: var(--space-sm); flex: 1 0 auto; }
  .choices button {
    flex: 1 1 0;
    min-height: 44px;
    padding: 10px 20px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    background: var(--fill);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  @media (hover: hover) {
    .choices button:hover { border-color: var(--ink-2); }
  }
  .slim { display: none; }
  @media (max-width: 760px) {
    .wide { display: none; }
    .slim { display: inline; }
    .consent { gap: var(--space-sm); padding: 10px; font-size: 13px; line-height: 1.3; }
    .consent p { flex: 1 1 9em; min-width: 0; padding-left: 4px; }
    .choices { flex: 0 1 auto; }
    .choices button { flex: 1 0 auto; padding: 0 14px; font-size: 14px; }
  }
</style>
