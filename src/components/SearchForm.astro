---
import AppStrip from './AppStrip.astro';
import AdSlot from './AdSlot.astro';
import AppStoreBadge from './AppStoreBadge.astro';
import PlaceCombo from './PlaceCombo.astro';
import { APP_STORE_URL, CONTRACT_1_12, LIBRARY, SIGN_IN, SIGN_IN_PROVIDERS } from '../app';
import { APPLE_LOGO } from '../icons';
import { DEFAULT_LANG, useLang, type Lang } from '../i18n';
import type { OptionField } from '../scripts/ffly-api';
import { TRAVELLER_KINDS, TRIP_TYPES } from '../scripts/filters';
import { webNudges } from '../scripts/nudges';
import '../styles/search.css';

interface Props { lang?: Lang; }

const { lang = DEFAULT_LANG } = Astro.props;
const { t, fmt, tag } = useLang(lang);
const w = t.widget;
const col = w.columns;
const COLUMNS = ['rank', 'route', 'dates', 'nights', 'flights', 'warn', 'total', 'details'] as const;

const openApp = APP_STORE_URL ?? '#app-side';
const LOCK = '<path d="M7 11V8a5 5 0 0 1 10 0v3"/><rect x="5" y="11" width="14" height="10" rx="2"/>';
// Spec 014's strings ship only with its UI, so the page stays as it was while CONTRACT_1_12 is off.
const v12 = CONTRACT_1_12 ? { offers: w.offers, account: w.account } : {};
// Spec 015: a locked chip shows while the API refuses the field of its control. "More cities" is a plan limit with no
// field: 1.0 always lists it, and v2, which says it through ffly Pro, never does (spec 016).
const LOCKED_FIELD: Partial<Record<keyof typeof w.appOnly, OptionField>> = {
  hours: 'schedule',
  direct: 'max_stops_per_leg',
  date: 'pinned',
  skip: 'excluded',
};
const appChips = Object.entries(w.appOnly).filter(([key]) => !(CONTRACT_1_12 && key === 'cities'));
const nudges = webNudges(w.script.nudges, tag);
const PRIORITIES = Object.keys(w.options.priorities) as (keyof typeof w.options.priorities)[];
---
<div class="search-ui" data-i18n={JSON.stringify({ ...w.script, nudges, columns: w.columns, nights: t.common.nights, loading: w.loading, ...v12 })}>
  <noscript>
    <div class="card notice">
      <p>{w.noscript}</p>
      <AppStoreBadge lang={lang} />
    </div>
  </noscript>

  <form id="search-form" class="card search-form" novalidate>
    <p id="search-loading" class="note">{w.loading}</p>
    <fieldset id="search-fields" class="fields" disabled>
      <legend class="sr-only">{w.legend}</legend>

      <div class="trip-type" role="group" aria-labelledby="trip-type-label">
        <span id="trip-type-label" class="sr-only">{w.tripType.label}</span>
        {TRIP_TYPES.map((type) => (
          <button type="button" class="segment" data-trip-type={type} aria-pressed={String(type === 'multi')}>{w.tripType[type]}</button>
        ))}
      </div>

      <div class="trip-row">
        <div class="field">
          <label id="from-label" for="from">{w.from} <span class="remembered" data-remembered="from" hidden>{w.remembered}</span></label>
          <PlaceCombo id="from" placeholder={w.typeCity} clear={w.clear} />
        </div>
        <div id="back-field" class="field">
          <label id="back-label" for="back">
            <span id="back-one">{w.back}</span><span id="back-any" hidden>{w.backAny}</span>
            <span id="ends-count" class="count" hidden></span>
            <span class="remembered" data-remembered="back" hidden>{w.remembered}</span>
          </label>
          <div class="place-box">
            <ul id="ends" class="chips" aria-label={w.back} data-placeholder={w.addCity} hidden></ul>
            <PlaceCombo id="back" placeholder={w.sameAsFrom} describedBy="back-hint" clear={w.clear} />
          </div>
          <p id="back-hint" class="sr-only">{w.backHint}</p>
        </div>
        <div id="to-field" class="field" hidden>
          <label id="to-label" for="to">{w.to}</label>
          <PlaceCombo id="to" placeholder={w.typeCity} clear={w.clear} />
        </div>
        <div class="field">
          <span id="window-label" class="field-label">{w.window}</span>
          <div class="popover-anchor">
            <button id="window" type="button" class="picker" aria-haspopup="dialog" aria-expanded="false" aria-controls="calendar" aria-labelledby="window-label window-text">
              <span id="window-text"></span>
            </button>
            <div id="calendar" class="calendar" role="dialog" aria-labelledby="window-label" hidden>
              <div class="cal-nav">
                <button id="cal-prev" type="button" aria-label={w.prevMonth}>&lsaquo;</button>
                <p class="hint">{w.calendarHint}</p>
                <button id="cal-next" type="button" aria-label={w.nextMonth}>&rsaquo;</button>
              </div>
              <div id="cal-months" class="cal-months"></div>
            </div>
          </div>
        </div>
        <fieldset id="nights-field" class="field">
          <legend class="field-label">{w.nights}</legend>
          <div class="steppers">
            {[
              { key: 'min', label: w.atLeast },
              { key: 'max', label: w.atMost },
            ].map((s, i) => (
              <Fragment>
                {i > 0 && <span class="range-dash" aria-hidden="true">–</span>}
                <div class="stepper" data-nights={s.key}>
                  <span id={`${s.key}-nights-label`} class="sr-only">{s.label}</span>
                  <button type="button" data-step="-1" aria-label={fmt.text(w.fewerNights, { label: s.label })}>&minus;</button>
                  <output id={`${s.key}-nights`} aria-labelledby={`${s.key}-nights-label`} aria-live="polite"></output>
                  <button type="button" data-step="1" aria-label={fmt.text(w.moreNights, { label: s.label })}>+</button>
                </div>
              </Fragment>
            ))}
          </div>
        </fieldset>
        <p id="ends-hint" class="hint" hidden>{w.backMany}</p>
      </div>

      <div class="cities-row">
        <div id="cities-field" class="field">
          <label id="city-label" for="city">
            {w.cities} <span id="city-count" class="count"></span>
            <span class="remembered" data-remembered="cities" hidden>{w.remembered}</span>
          </label>
          <div class="place-box">
            <ul id="cities" class="chips" aria-label={w.cities}></ul>
            <PlaceCombo id="city" placeholder={w.addCity} describedBy="city-hint" clear={w.clear} />
          </div>
          <p id="city-hint" class="sr-only">{w.cityHint}</p>
        </div>
        <button id="submit" class="btn" type="submit">{w.submit}</button>
      </div>

      <p id="form-error" class="form-error" role="alert"></p>

      <div class="app-row">
        <button id="options-toggle" type="button" class="row-button" aria-expanded="false" aria-controls="options">{w.options.toggle}</button>
        <button id="library-open" type="button" class="row-button" aria-haspopup="dialog">{w.library.open}</button>
        <span id="in-app-label" class="field-label">{w.inApp}</span>
        <ul class="locked-chips" aria-labelledby="in-app-label">
          {appChips.map(([key, o]) => (
            <li data-locked-field={LOCKED_FIELD[key as keyof typeof w.appOnly]}>
              <button type="button" class="locked-chip" data-nudge={o.nudge} aria-pressed="false" aria-controls="chip-nudge">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={LOCK} />
                {o.label}
              </button>
            </li>
          ))}
        </ul>
        <p id="quota-note" class="note"></p>
        {SIGN_IN && (
          <div class="account">
            <span id="account-status" class="note" aria-live="polite"></span>
            <button id="sign-in" type="button" class="btn" data-sign-in>{w.account.signIn}</button>
            <button id="sign-out" type="button" class="btn btn-soon" hidden>{w.account.signOut}</button>
          </div>
        )}
      </div>
      <p id="chip-nudge" class="chip-nudge" aria-live="polite" hidden></p>

      <div id="options" class="options" hidden>
        <fieldset class="option" data-any="travellers" hidden>
          <legend class="field-label">{w.options.travellers}</legend>
          <div class="option-controls">
            {TRAVELLER_KINDS.map((kind) => (
              <div class="stepper labelled" data-traveller={kind}>
                <span id={`${kind}-label`} class="stepper-label">{w.options[kind]}</span>
                <button type="button" data-step="-1" aria-label={fmt.text(w.options.fewer, { label: w.options[kind] })}>&minus;</button>
                <output id={`${kind}-count`} aria-labelledby={`${kind}-label`} aria-live="polite"></output>
                <button type="button" data-step="1" aria-label={fmt.text(w.options.more, { label: w.options[kind] })}>+</button>
              </div>
            ))}
          </div>
        </fieldset>
        <fieldset class="option" data-any="priority" hidden>
          <legend class="field-label">{w.options.priority}</legend>
          <div class="option-controls">
            {PRIORITIES.map((id) => (
              <button type="button" class="segment" data-priority={id} aria-pressed="false" hidden>{w.options.priorities[id]}</button>
            ))}
          </div>
        </fieldset>
        <fieldset class="option" data-any="max_stops_per_leg max_stops_total" hidden>
          <legend class="field-label">{w.options.connections}</legend>
          <div class="option-controls">
            <button id="direct-only" type="button" class="segment" data-field="max_stops_per_leg" aria-pressed="false" hidden>{w.options.directOnly}</button>
            <div class="stepper labelled" data-connections data-field="max_stops_total" hidden>
              <span id="connections-label" class="stepper-label">{w.options.maxConnections}</span>
              <button type="button" data-step="-1" aria-label={w.options.fewerConnections}>&minus;</button>
              <output id="connections-count" aria-labelledby="connections-label" aria-live="polite"></output>
              <button type="button" data-step="1" aria-label={w.options.moreConnections}>+</button>
            </div>
          </div>
        </fieldset>
        <fieldset class="option" data-any="schedule" hidden>
          <legend class="field-label">{w.options.hours}</legend>
          <div class="option-controls">
            {[
              { id: 'takeoff', label: w.options.takeoff },
              { id: 'landing', label: w.options.landing },
            ].map((h) => (
              <div class="hour popover-anchor">
                <span id={`${h.id}-label`} class="stepper-label">{h.label}</span>
                <button id={h.id} type="button" class="picker" aria-haspopup="listbox" aria-expanded="false" aria-controls={`${h.id}-list`} aria-labelledby={`${h.id}-label ${h.id}`}></button>
                <ul id={`${h.id}-list`} class="listbox time-list" role="listbox" tabindex="-1" aria-labelledby={`${h.id}-label`} hidden></ul>
              </div>
            ))}
          </div>
          <p class="hint">{w.options.hoursHint}</p>
        </fieldset>
        <fieldset id="places-option" class="option" data-any="pinned airports" hidden>
          <legend class="field-label">{w.options.places}</legend>
          <p class="hint" data-field="pinned" hidden>{w.options.pinHint}</p>
          <ul id="place-options" class="place-options"></ul>
        </fieldset>
        <div class="option field">
          <label id="passport-label" for="passport" class="field-label">{w.options.passports}</label>
          <div class="place-box">
            <ul id="passports" class="chips" aria-label={w.options.passports}></ul>
            <PlaceCombo id="passport" placeholder={w.options.addPassport} describedBy="passport-hint" clear={w.clear} />
          </div>
          <p id="passport-hint" class="hint">{w.options.passportsHint}</p>
        </div>
      </div>
    </fieldset>
  </form>

  <AppStrip lang={lang} />

  <div id="problem" class="card problem" role="alert" hidden>
    <p id="problem-text"></p>
    <button id="retry" class="btn btn-soon" type="button" hidden>{w.retry}</button>
  </div>

  <section id="progress" class="card progress" aria-labelledby="progress-title" hidden>
    <p id="progress-title" class="lbl">{w.searching}</p>
    <p id="progress-status" class="status" aria-live="polite"></p>
    <div id="progress-bar" class="bar" role="progressbar" aria-labelledby="progress-title" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span id="progress-fill"></span>
    </div>
    <p id="progress-detail" class="note"></p>
    <p id="queue-nudge" class="queue-nudge">{w.script.nudges.queue}</p>
    <div id="notify-ask" class="notify-ask" hidden>
      <p>{w.notifyAsk}</p>
      <div class="notify-buttons">
        <button id="notify-yes" type="button" class="btn">{w.notifyYes}</button>
        <button id="notify-no" type="button" class="btn btn-soon">{w.notifyNo}</button>
      </div>
    </div>
    {CONTRACT_1_12 && <div id="progress-kit" hidden></div>}
  </section>

  <section id="results" class="results" aria-labelledby="results-title" aria-live="polite">
    <h2 id="results-title" hidden>{w.emptyState}</h2>
    <p id="results-trip" class="note" hidden></p>
    <p id="results-shared" class="shared-line" hidden>
      <span id="results-searched"></span>
      <button id="search-again" type="button" class="btn btn-soon">{w.searchAgain}</button>
    </p>
    <p id="results-empty" class="note" hidden>{w.empty}</p>
    <div id="skipped" class="skipped" hidden>
      <span id="skipped-label" class="lbl"></span>
      <ul id="skipped-list" class="skipped-list" aria-labelledby="skipped-label"></ul>
      <button id="skipped-undo" type="button" class="btn btn-soon" hidden></button>
    </div>
    <p id="insights" class="insights" hidden></p>
    <p id="app-hint" class="app-hint" hidden></p>
    <div class="table-wrap">
      <table class="results-table">
        <thead>
          <tr>
            {COLUMNS.map((c) => <th scope="col">{c === 'details' ? <span class="sr-only">{col[c]}</span> : col[c]}</th>)}
          </tr>
        </thead>
        <tbody id="route-placeholder" class="placeholder">
          <tr class="placeholder-note"><td colspan={COLUMNS.length}>{w.emptyState}</td></tr>
          {[1, 2].map(() => (
            <tr class="skeleton" aria-hidden="true">
              {COLUMNS.map((c) => <td class={c}><i class="bone"></i></td>)}
            </tr>
          ))}
        </tbody>
        <tbody id="route-rows"></tbody>
      </table>
    </div>
    <p id="more-routes" hidden><a href="#app-side"></a></p>
    <p id="visa-note" class="quiet" hidden></p>
    <div id="rating" class="rating" hidden>
      <p id="rating-title" class="rating-title">{w.rating.title}</p>
      <p id="rating-thanks" class="rating-title" hidden>{w.rating.thanks}</p>
      <div id="rating-stars" class="stars" role="group" aria-labelledby="rating-title">
        {Array.from({ length: LIBRARY.stars }, (_, i) => (
          <button type="button" class="star" data-stars={i + 1} aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z" /></svg>
          </button>
        ))}
      </div>
      <a id="rating-support" href="/support" hidden>{w.rating.support}</a>
      <button id="rating-dismiss" type="button" class="link-button">{w.notifyNo}</button>
    </div>
    <p class="quiet">{w.disclosure}</p>
    <p id="coverage" class="quiet" hidden></p>
    <AdSlot slot="searchResults" size="banner" />
  </section>

  <section id="upsell" class="card upsell" aria-labelledby="upsell-title" hidden>
    <p class="lbl">{t.common.appForIphone}</p>
    {CONTRACT_1_12 ? (
      <Fragment>
        <h2 id="upsell-title">{w.offers.upsellTitle}</h2>
        <ul class="plan-compare">
          <li>{w.offers.free}</li>
          <li>{w.offers.pro}</li>
        </ul>
      </Fragment>
    ) : (
      <Fragment>
        <h2 id="upsell-title">{w.upsellTitle}</h2>
        <p>{w.upsellBody}</p>
      </Fragment>
    )}
    {SIGN_IN && (
      <p class="upsell-account">{w.account.alreadyPro} <button type="button" class="link-button" data-sign-in>{w.account.sameAccount}</button></p>
    )}
    <AppStoreBadge lang={lang} />
  </section>

  <dialog id="library-sheet" class="sheet library-sheet" aria-labelledby="library-title">
    <h2 id="library-title">{w.library.open}</h2>
    <section class="library-block" aria-labelledby="saved-title">
      <h3 id="saved-title">{w.library.saved}</h3>
      <p id="saved-empty" class="note">{w.library.savedEmpty}</p>
      <p id="compare-hint" class="hint" hidden></p>
      <ul id="saved-list" class="library-list"></ul>
      <div id="compare" class="compare" hidden>
        <h3 id="compare-title"></h3>
        <div class="table-wrap"><table class="compare-table"><tbody id="compare-rows"></tbody></table></div>
      </div>
      <p class="quiet">{w.library.savedNote}</p>
    </section>
    <section class="library-block" aria-labelledby="history-title">
      <h3 id="history-title">{w.library.history}</h3>
      <p id="history-empty" class="note">{w.library.historyEmpty}</p>
      <ul id="history-list" class="library-list"></ul>
    </section>
    <button id="library-close" type="button" class="btn btn-soon">{w.library.close}</button>
  </dialog>

  {SIGN_IN && (
    <dialog id="sign-in-sheet" class="sheet" aria-labelledby="sign-in-title">
      <h2 id="sign-in-title">{w.account.title}</h2>
      <p class="note">{w.account.body}</p>
      <div class="providers">
        {SIGN_IN_PROVIDERS.includes('apple') && (
          <button id="apple-sign-in" type="button" class="apple-button" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={APPLE_LOGO} /></svg>
            {w.account.apple}
          </button>
        )}
        {SIGN_IN_PROVIDERS.includes('google') && <div id="gis-sign-in" class="gis-button" hidden></div>}
      </div>
      <p id="sign-in-error" class="form-error" role="alert"></p>
      <button id="sign-in-close" type="button" class="link-button sheet-close">{w.account.close}</button>
    </dialog>
  )}
</div>

<template id="place-option-template">
  <li class="place" role="option"><span class="place-name"><span class="place-local"></span><span class="place-alt" lang="en"></span><span class="place-native"></span><span class="place-country"></span></span><span class="place-airports"><span class="place-all"></span><span class="place-codes"></span></span><code class="place-code"></code></li>
</template>

<template id="place-notice-template">
  <li class="place place-notice" role="option" aria-disabled="true"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={LOCK} /><span class="notice-text"></span></li>
</template>

<template id="chip-template">
  <li class="chip"><span class="chip-name"></span><button type="button" class="chip-mode" aria-pressed="false" hidden></button><button type="button" class="chip-remove">&times;</button></li>
</template>

<template id="place-option-row-template">
  <li class="place-option"><span class="place-option-name"></span><span class="pin popover-anchor" hidden><button type="button" class="picker pin-picker" aria-haspopup="dialog" aria-expanded="false"><span class="pin-text"></span></button><button type="button" class="chip-remove pin-remove" hidden>&times;</button><div class="calendar" role="dialog" hidden><div class="cal-nav"><button type="button" class="cal-prev" aria-label={w.prevMonth}>&lsaquo;</button><p class="hint">{w.calendarHint}</p><button type="button" class="cal-next" aria-label={w.nextMonth}>&rsaquo;</button></div><div class="cal-months"></div></div></span><span class="airport-toggles" hidden></span></li>
</template>

<template id="library-row-template">
  <li class="library-row"><div class="library-text"><span class="library-route"></span><span class="library-meta note"></span></div><div class="library-actions"><button type="button" class="btn btn-soon library-compare" aria-pressed="false" hidden></button><button type="button" class="btn btn-soon library-open"></button><button type="button" class="btn btn-soon library-remove"></button></div></li>
</template>

<template id="route-row-template">
  <tr class="route-row">
    <td class="rank" data-label={col.rank}></td>
    <td class="route" data-label={col.route}></td>
    <td class="dates" data-label={col.dates}></td>
    <td class="nights" data-label={col.nights}></td>
    <td class="flights" data-label={col.flights}></td>
    <td class="warn" data-label={col.warn}><ul class="warn-chips"></ul></td>
    <td class="total" data-label={col.total}></td>
    <td class="details"><button type="button" class="details-toggle" aria-expanded="false">{col.details}</button></td>
  </tr>
</template>

<template id="warn-template">
  <li class="warn-chip"></li>
</template>

<template id="leg-row-template">
  <tr class="leg-row" hidden>
    <td colspan={COLUMNS.length}>
      <div class="leg">
        <span class="leg-day"></span>
        <span class="leg-time"></span>
        <span class="leg-path"><span class="leg-from"></span> <code class="leg-from-code"></code> &rarr; <span class="leg-to"></span> <code class="leg-to-code"></code></span>
        <span class="leg-nights"></span>
        <span class="leg-carrier"></span>
        <span class="leg-stops"></span>
        <span class="leg-price"></span>
        <a class="btn book" target="_blank" rel="sponsored noopener">{w.book}</a>
        <span class="leg-warn" hidden></span>
        <span class="leg-menu popover-anchor" hidden><button type="button" class="leg-more" aria-haspopup="menu" aria-expanded="false">&middot;&middot;&middot;</button><span class="menu" role="menu" hidden><button type="button" class="menu-item leg-skip" role="menuitem"></button></span></span>
      </div>
    </td>
  </tr>
</template>

<template id="detail-row-template">
  <tr class="detail-row"><td colspan={COLUMNS.length}></td></tr>
</template>

<template id="route-actions-template">
  <div class="route-actions"><button type="button" class="btn btn-soon route-save" aria-pressed="false"></button><button type="button" class="btn btn-soon route-share"></button><span class="route-status note" role="status"></span></div>
</template>

{CONTRACT_1_12 && (
  <Fragment>
    <template id="kit-template">
      <div class="kit">
        <p class="kit-title">{w.offers.partnerOffers}</p>
        <ul class="kit-list"></ul>
      </div>
    </template>
    <template id="kit-group-template">
      <li class="kit-group"><span class="kit-kind"></span><span class="kit-links"></span></li>
    </template>
    <template id="kit-link-template">
      <a class="kit-link" target="_blank" rel="sponsored noopener"></a>
    </template>
  </Fragment>
)}

<template id="locked-row-template">
  <tr class="locked-row">
    <td class="rank" data-label={col.rank}></td>
    <td class="locked-cell" colspan="5">
      <span class="blurred" aria-hidden="true">{w.lockedSample}</span>
      <span class="locked-text"></span>
    </td>
    <td class="total" data-label={col.total}></td>
    <td class="details"><a class="open-app" href={openApp}>{w.openApp}</a></td>
  </tr>
</template>

<script>
  import '../scripts/search';
</script>
