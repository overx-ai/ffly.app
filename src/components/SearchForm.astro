---
import AppStrip from './AppStrip.astro';
import AdSlot from './AdSlot.astro';
import AppStoreBadge from './AppStoreBadge.astro';
import PlaceCombo from './PlaceCombo.astro';
import { APP_STORE_URL } from '../app';
import { DEFAULT_LANG, useLang, type Lang } from '../i18n';
import '../styles/search.css';

interface Props { lang?: Lang; }

const { lang = DEFAULT_LANG } = Astro.props;
const { t, fmt } = useLang(lang);
const w = t.widget;
const col = w.columns;
const COLUMNS = ['rank', 'route', 'dates', 'nights', 'flights', 'warn', 'total', 'details'] as const;

const openApp = APP_STORE_URL ?? '#app-side';
const LOCK = '<path d="M7 11V8a5 5 0 0 1 10 0v3"/><rect x="5" y="11" width="14" height="10" rx="2"/>';
---
<div class="search-ui" data-i18n={JSON.stringify({ ...w.script, nights: t.common.nights })}>
  <noscript>
    <div class="card notice">
      <p>{w.noscript}</p>
      <AppStoreBadge lang={lang} />
    </div>
  </noscript>

  <form id="search-form" class="card search-form" novalidate>
    <p id="search-loading" class="note">{w.loading}</p>
    <fieldset id="search-fields" class="fields" disabled>
      <legend class="sr-only">{w.legend}</legend>

      <div class="trip-row">
        <div class="field">
          <label id="from-label" for="from">{w.from} <span class="remembered" data-remembered="from" hidden>{w.remembered}</span></label>
          <PlaceCombo id="from" placeholder={w.typeCity} />
        </div>
        <div class="field">
          <label id="back-label" for="back">{w.back} <span class="remembered" data-remembered="back" hidden>{w.remembered}</span></label>
          <PlaceCombo id="back" placeholder={w.sameAsFrom} describedBy="back-hint" />
          <p id="back-hint" class="sr-only">{w.backHint}</p>
        </div>
        <div class="field">
          <span id="window-label" class="field-label">{w.window}</span>
          <div class="popover-anchor">
            <button id="window" type="button" class="picker" aria-haspopup="dialog" aria-expanded="false" aria-controls="calendar" aria-labelledby="window-label window-text">
              <span id="window-text"></span>
            </button>
            <div id="calendar" class="calendar" role="dialog" aria-labelledby="window-label" hidden>
              <div class="cal-nav">
                <button id="cal-prev" type="button" aria-label={w.prevMonth}>&lsaquo;</button>
                <p class="hint">{w.calendarHint}</p>
                <button id="cal-next" type="button" aria-label={w.nextMonth}>&rsaquo;</button>
              </div>
              <div id="cal-months" class="cal-months"></div>
            </div>
          </div>
        </div>
        <fieldset class="field">
          <legend class="field-label">{w.nights}</legend>
          <div class="steppers">
            {[
              { key: 'min', label: w.atLeast },
              { key: 'max', label: w.atMost },
            ].map((s, i) => (
              <Fragment>
                {i > 0 && <span class="range-dash" aria-hidden="true">–</span>}
                <div class="stepper" data-nights={s.key}>
                  <span id={`${s.key}-nights-label`} class="sr-only">{s.label}</span>
                  <button type="button" data-step="-1" aria-label={fmt.text(w.fewerNights, { label: s.label })}>&minus;</button>
                  <output id={`${s.key}-nights`} aria-labelledby={`${s.key}-nights-label`} aria-live="polite"></output>
                  <button type="button" data-step="1" aria-label={fmt.text(w.moreNights, { label: s.label })}>+</button>
                </div>
              </Fragment>
            ))}
          </div>
        </fieldset>
      </div>

      <div class="cities-row">
        <div class="field">
          <label id="city-label" for="city">
            {w.cities} <span id="city-count" class="count"></span>
            <span class="remembered" data-remembered="cities" hidden>{w.remembered}</span>
          </label>
          <div class="city-box">
            <ul id="cities" class="chips" aria-label={w.cities}></ul>
            <PlaceCombo id="city" placeholder={w.addCity} describedBy="city-hint" />
          </div>
          <p id="city-hint" class="sr-only">{w.cityHint}</p>
        </div>
        <button id="submit" class="btn" type="submit">{w.submit}</button>
      </div>

      <p id="form-error" class="form-error" role="alert"></p>

      <div class="app-row">
        <span id="in-app-label" class="field-label">{w.inApp}</span>
        <ul class="locked-chips" aria-labelledby="in-app-label">
          {Object.values(w.appOnly).map((o) => (
            <li>
              <button type="button" class="locked-chip" data-nudge={o.nudge} aria-pressed="false" aria-controls="chip-nudge">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={LOCK} />
                {o.label}
              </button>
            </li>
          ))}
        </ul>
        <p id="quota-note" class="note"></p>
      </div>
      <p id="chip-nudge" class="chip-nudge" aria-live="polite" hidden></p>
    </fieldset>
  </form>

  <AppStrip lang={lang} />

  <div id="problem" class="card problem" role="alert" hidden>
    <p id="problem-text"></p>
    <button id="retry" class="btn btn-soon" type="button" hidden>{w.retry}</button>
  </div>

  <section id="progress" class="card progress" aria-labelledby="progress-title" hidden>
    <p id="progress-title" class="lbl">{w.searching}</p>
    <p id="progress-status" class="status" aria-live="polite"></p>
    <div id="progress-bar" class="bar" role="progressbar" aria-labelledby="progress-title" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span id="progress-fill"></span>
    </div>
    <p id="progress-detail" class="note"></p>
    <p class="queue-nudge">{w.script.nudges.queue}</p>
    <div id="notify-ask" class="notify-ask" hidden>
      <p>{w.notifyAsk}</p>
      <div class="notify-buttons">
        <button id="notify-yes" type="button" class="btn">{w.notifyYes}</button>
        <button id="notify-no" type="button" class="btn btn-soon">{w.notifyNo}</button>
      </div>
    </div>
  </section>

  <section id="results" class="results" aria-labelledby="results-title" aria-live="polite">
    <h2 id="results-title" hidden>{w.emptyState}</h2>
    <p id="results-trip" class="note" hidden></p>
    <p id="results-shared" class="shared-line" hidden>
      <span id="results-searched"></span>
      <button id="search-again" type="button" class="btn btn-soon">{w.searchAgain}</button>
    </p>
    <p id="results-empty" class="note" hidden>{w.empty}</p>
    <p id="insights" class="insights" hidden></p>
    <p id="app-hint" class="app-hint" hidden></p>
    <div class="table-wrap">
      <table class="results-table">
        <thead>
          <tr>
            {COLUMNS.map((c) => <th scope="col">{c === 'details' ? <span class="sr-only">{col[c]}</span> : col[c]}</th>)}
          </tr>
        </thead>
        <tbody id="route-placeholder" class="placeholder">
          <tr class="placeholder-note"><td colspan={COLUMNS.length}>{w.emptyState}</td></tr>
          {[1, 2].map(() => (
            <tr class="skeleton" aria-hidden="true">
              {COLUMNS.map((c) => <td class={c}><i class="bone"></i></td>)}
            </tr>
          ))}
        </tbody>
        <tbody id="route-rows"></tbody>
      </table>
    </div>
    <p id="more-routes" hidden><a href="#app-side"></a></p>
    <p class="quiet">{w.disclosure}</p>
    <p id="coverage" class="quiet" hidden></p>
    <AdSlot slot="searchResults" size="banner" />
  </section>

  <section id="upsell" class="card upsell" aria-labelledby="upsell-title" hidden>
    <p class="lbl">{t.common.appForIphone}</p>
    <h2 id="upsell-title">{w.upsellTitle}</h2>
    <p>{w.upsellBody}</p>
    <AppStoreBadge lang={lang} />
  </section>
</div>

<template id="place-option-template">
  <li class="place" role="option"><span class="place-name"></span><span class="place-airports"></span><code class="place-code"></code></li>
</template>

<template id="place-notice-template">
  <li class="place place-notice" role="option" aria-disabled="true"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={LOCK} /><span class="notice-text"></span></li>
</template>

<template id="chip-template">
  <li class="chip"><span class="chip-name"></span><button type="button" class="chip-remove">&times;</button></li>
</template>

<template id="route-row-template">
  <tr class="route-row">
    <td class="rank" data-label={col.rank}></td>
    <td class="route" data-label={col.route}></td>
    <td class="dates" data-label={col.dates}></td>
    <td class="nights" data-label={col.nights}></td>
    <td class="flights" data-label={col.flights}></td>
    <td class="warn" data-label={col.warn}><ul class="warn-chips"></ul></td>
    <td class="total" data-label={col.total}></td>
    <td class="details"><button type="button" class="details-toggle" aria-expanded="false">{col.details}</button></td>
  </tr>
</template>

<template id="warn-template">
  <li class="warn-chip"></li>
</template>

<template id="leg-row-template">
  <tr class="leg-row" hidden>
    <td colspan={COLUMNS.length}>
      <div class="leg">
        <span class="leg-day"></span>
        <span class="leg-time"></span>
        <span class="leg-path"><span class="leg-from"></span> <code class="leg-from-code"></code> &rarr; <span class="leg-to"></span> <code class="leg-to-code"></code></span>
        <span class="leg-nights"></span>
        <span class="leg-carrier"></span>
        <span class="leg-stops"></span>
        <span class="leg-price"></span>
        <a class="btn book" target="_blank" rel="sponsored noopener">{w.book}</a>
      </div>
    </td>
  </tr>
</template>

<template id="locked-row-template">
  <tr class="locked-row">
    <td class="rank" data-label={col.rank}></td>
    <td class="locked-cell" colspan="5">
      <span class="blurred" aria-hidden="true">{w.lockedSample}</span>
      <span class="locked-text"></span>
    </td>
    <td class="total" data-label={col.total}></td>
    <td class="details"><a class="open-app" href={openApp}>{w.openApp}</a></td>
  </tr>
</template>

<script>
  import '../scripts/search';
</script>
