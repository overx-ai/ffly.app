---
import LanguageLinks from './LanguageLinks.astro';
import { DEFAULT_LANG, localeOf, shortCode, useLang, type Lang } from '../i18n';
import type { Slug } from '../site-pages';

interface Props {
  lang?: Lang;
  slug?: Slug;
  // At the foot of the page: the language's name on the pill, and the panel opens upward.
  footer?: boolean;
}

const { lang = DEFAULT_LANG, slug, footer = false } = Astro.props;
const { languages } = useLang(lang).t.common.footer;
const locale = localeOf(lang);
const code = shortCode(locale);
---
<details class:list={['lang-menu', { up: footer }]}>
  <summary aria-label={`${languages} (${footer ? locale.name : code})`}>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
    </svg>
    <span aria-hidden="true">{footer ? locale.name : code}</span>
    {footer && (
      <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 4.5l3 3 3-3" />
      </svg>
    )}
  </summary>
  <nav class="lang-panel" aria-label={languages}>
    <LanguageLinks lang={lang} slug={slug} />
  </nav>
</details>

<style>
  .lang-menu { position: relative; }
  .lang-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 44px;
    min-height: 44px;
    padding-inline: 10px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font: 600 13px var(--font-mono);
    list-style: none;
    cursor: pointer;
  }
  .lang-menu summary::-webkit-details-marker { display: none; }
  .lang-menu summary:hover,
  .lang-menu[open] summary { color: var(--ink); border-color: var(--ink-2); }
  .up summary { padding-inline: 12px 14px; font: 500 14px var(--font-body); }
  .up[open] .chevron { transform: rotate(180deg); }
  .lang-panel {
    position: absolute;
    z-index: 6;
    top: calc(100% + 6px);
    right: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    width: max-content;
    max-width: calc(100vw - 2 * var(--gutter));
    padding: 6px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow);
  }
  .up .lang-panel { top: auto; bottom: calc(100% + 6px); right: auto; left: 0; }
  .lang-panel :global(a) {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 12px;
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: 15px;
    text-decoration: none;
  }
  .lang-panel :global(a:hover) { background: var(--fill); }
  .lang-panel :global([aria-current]) { background: var(--fill); font-weight: 700; }
  @media (max-width: 420px) {
    .lang-menu:not(.up) summary { padding-inline: 0; justify-content: center; }
    .lang-menu:not(.up) summary span { display: none; }
  }
</style>
