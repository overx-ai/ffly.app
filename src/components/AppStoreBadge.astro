---
import { APP_STORE_URL } from '../app';
import { APPLE_LOGO } from '../icons';
import { DEFAULT_LANG, useLang, type Lang } from '../i18n';

interface Props { lang?: Lang; placement: string; }

const { lang = DEFAULT_LANG, placement } = Astro.props;
const { store } = useLang(lang).t.common;
---
<a class="store" href={APP_STORE_URL} rel="noopener" data-store={placement}>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
    <path d={APPLE_LOGO} />
  </svg>
  <span>{store.download}</span>
</a>

<style>
  /* A parent can invert the pill by setting --store-bg and --store-ink, as the dark close band does. */
  .store {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--store-bg, var(--ink));
    color: var(--store-ink, var(--bg));
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 15px;
    padding: 12px 20px;
    border-radius: var(--radius-pill);
    min-height: 44px;
    text-decoration: none;
  }
  .store:hover { text-decoration: none; filter: brightness(1.15); }
</style>
