---
import AppStoreBadge from './AppStoreBadge.astro';
import { DEFAULT_LANG, useLang, type Lang } from '../i18n';
import { pathFor } from '../site-pages';

interface Props { lang?: Lang; }

const { lang = DEFAULT_LANG } = Astro.props;
const { t } = useLang(lang);
---
<div class="ctas">
  <AppStoreBadge lang={lang} />
  <a class="btn" href={`${pathFor('', lang)}#search`}>{t.common.searchFree}</a>
</div>

<style>
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .btn { font-size: 15px; padding: 12px 20px; }
</style>
