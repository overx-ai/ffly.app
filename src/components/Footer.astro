---
import { CONSENT_NEEDED, CONTACT_EMAIL, DEVELOPER, PUBLISHER } from '../app';
import LanguageLinks from './LanguageLinks.astro';
import { DEFAULT_LANG, useLang, type Lang } from '../i18n';
import { hreflangOf, pathFor, type Slug } from '../site-pages';

interface Props {
  lang?: Lang;
  slug?: Slug;
}

const { lang = DEFAULT_LANG, slug } = Astro.props;
const { t } = useLang(lang);
const { footer } = t.common;
const year = new Date().getFullYear();
const pageLinks = [
  { slug: 'guides', label: footer.guides },
  { slug: 'support', label: footer.support },
  { slug: 'privacy', label: footer.privacy },
  { slug: 'terms', label: footer.terms },
] as const satisfies readonly { slug: Slug; label: string }[];
---
<footer>
  <div class="container">
    <nav class="links" aria-label={footer.label}>
      {pageLinks.map((link) => (
        <a href={pathFor(link.slug, lang)} hreflang={hreflangOf(link.slug, lang)}>{link.label}</a>
      ))}
      {CONSENT_NEEDED && <button type="button" data-consent-open>{t.consent.settings}</button>}
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <span>&copy; {year} {DEVELOPER}</span>
      <span>{footer.createdBy} <a href={PUBLISHER.url} rel="noopener">{PUBLISHER.label}</a></span>
    </nav>
    <h2 class="langs-title" id="footer-languages">{footer.languages}</h2>
    <nav class="langs" aria-labelledby="footer-languages">
      <LanguageLinks lang={lang} slug={slug} guides />
    </nav>
    <p class="fine">{footer.disclaimer}</p>
  </div>
</footer>

<style>
  footer {
    padding-block: var(--space-lg) var(--space-xl);
    color: var(--ink-2);
    font-size: 14px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-lg);
  }
  .links > :global(*) { min-height: 44px; display: inline-flex; align-items: center; gap: 0.3em; }
  .links :global(a) { color: var(--ink-2); text-decoration: none; }
  .links button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .links :global(a:hover), .links button:hover { color: var(--ink); }
  .links span a { text-decoration: underline; }
  .langs-title {
    font: 600 12px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-top: var(--space-md);
  }
  .langs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-sm);
  }
  .langs :global(.cell) { display: flex; flex-direction: column; min-width: 0; }
  .langs :global(a) {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-2);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  /* Name and hub text meet in the middle of the cell, so each keeps a full 44px target without looking detached. */
  .langs :global(a.name) { align-items: flex-end; }
  .langs :global(a.hub) { align-items: flex-start; padding-top: var(--space-xs); font-size: 12px; }
  .langs :global(a:hover) { color: var(--ink); }
  .langs :global([aria-current]) { color: var(--ink); font-weight: 700; }
  @media (max-width: 599px) {
    .langs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .fine {
    font-size: 13px;
    line-height: 1.55;
    max-width: 70ch;
    padding-top: var(--space-xs);
  }
</style>
