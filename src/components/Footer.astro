---
import { APP, CONTACT_EMAIL, DEVELOPER, PUBLISHER } from '../app';
import { pathFor } from '../site-pages';
const year = new Date().getFullYear();
---
<footer>
  <div class="container">
    <nav class="links" aria-label="Footer">
      <a href={pathFor('support')}>Support</a>
      <a href={pathFor('privacy')}>Privacy</a>
      <a href={pathFor('terms')}>Terms</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <span>&copy; {year} {DEVELOPER}</span>
      <span>Created by <a href={PUBLISHER.url} rel="noopener">{PUBLISHER.label}</a></span>
    </nav>
    <p class="fine">
      {APP.name} is a search tool, not a travel agent, and is not affiliated with any airline. Fares are
      indicative: confirm the final price on the site you book on.
    </p>
  </div>
</footer>

<style>
  footer {
    padding-block: var(--space-lg) var(--space-xl);
    color: var(--ink-2);
    font-size: 14px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-lg);
  }
  .links > * { min-height: 44px; display: inline-flex; align-items: center; gap: 0.3em; }
  .links a { color: var(--ink-2); text-decoration: none; }
  .links a:hover { color: var(--ink); }
  .links span a { text-decoration: underline; }
  .fine {
    font-size: 13px;
    line-height: 1.55;
    max-width: 70ch;
    padding-top: var(--space-xs);
  }
</style>
