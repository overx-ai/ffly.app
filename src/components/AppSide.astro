---
import AppStoreBadge from './AppStoreBadge.astro';
import { APP, EXAMPLE_TRIP, NUDGES } from '../app';

const visits = EXAMPLE_TRIP.stops.filter((s) => 'nights' in s);
---
<aside id="app-side" class="app-side" aria-labelledby="app-side-title">
  <p class="lbl">{APP.name} for iPhone</p>
  <p id="app-side-title" class="side-title">More in the app</p>
  <div class="phone" aria-hidden="true">
    <p class="phone-title">Trips</p>
    <div class="phone-card">
      <p class="phone-route">{EXAMPLE_TRIP.stops.map((s) => s.code).join(' → ')}</p>
      <ol class="chain">
        {visits.map((s) => (
          <li><span class="city">{s.city}</span><span class="nights">{`${s.nights} nights`}</span></li>
        ))}
      </ol>
    </div>
  </div>
  <p id="nudge" class="nudge" aria-live="polite">{NUDGES.rotation[0]}</p>
  <ol id="nudge-dots" class="dots" aria-hidden="true">
    {NUDGES.rotation.map((_, i) => <li class:list={{ on: i === 0 }} />)}
  </ol>
  <p class="price-line">{NUDGES.priceLine}</p>
  <AppStoreBadge />
</aside>

<style>
  .app-side {
    background: var(--night);
    color: var(--on-night);
    border: 1px solid var(--rule);
    --store-bg: var(--on-night);
    --store-ink: var(--night);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
    scroll-margin-top: var(--header-height);
  }
  .app-side .lbl { color: var(--gold); }
  .side-title { font: 800 1.6rem/1.05 var(--font-display); letter-spacing: -0.03em; }
  .phone {
    align-self: stretch;
    border: 1px solid var(--navy-edge);
    border-radius: 28px;
    padding: 18px 14px;
    background: var(--navy-deep);
  }
  .phone-title { font: 800 20px var(--font-display); margin-bottom: 10px; }
  .phone-card { background: var(--navy-raised); border-radius: var(--radius-md); padding: 12px 14px; }
  .phone-route { font: 600 12px var(--font-mono); color: var(--gold); letter-spacing: 0.04em; margin-bottom: 4px; }
  .phone .nights { color: var(--navy-haze); }
  .nudge { font: 700 1.15rem/1.3 var(--font-display); min-height: 2.6em; }
  .dots { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; }
  .dots li { width: 6px; height: 6px; border-radius: 50%; background: var(--navy-edge); }
  .dots li.on { background: var(--gold); width: 18px; border-radius: var(--radius-pill); }
  .price-line { border-left: 3px solid var(--gold); padding-left: 12px; color: var(--navy-haze); font-weight: 600; }
</style>
